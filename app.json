{
  "expo": {
    "name": "Yatrenzo",
    "slug": "yatrenzo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yatrenzo",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.yatrenzo.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yatrenzo.app",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Yatrenzo to access your photos to select your profile picture.",
          "cameraPermission": "Allow Yatrenzo to access your camera to take a profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yatrenzo uses your location to send your real position when you trigger an SOS alert, and to show it on the trip map."
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-secure-store",
      "expo-notifications",
      "expo-localization",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9de41b02-3359-4583-bda7-d81ebfe1b8d6"
      }
    },
    "owner": "harsh_16",
    "updates": {
      "url": "https://u.expo.dev/9de41b02-3359-4583-bda7-d81ebfe1b8d6"
    }
  }
}
