# PostgreSQL Database Connection String
DATABASE_URL=

# JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 bytes. Never commit a real value here or in .env.
JWT_SECRET=

# Access token lifetime (jsonwebtoken duration string)
JWT_ACCESS_TOKEN_TTL=15m

# Refresh token / session lifetime, in days
JWT_REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Server Port
PORT=5000

# Environment
NODE_ENV=development

# Prisma connection-pool sizing (Phase 10). Set this from your database's
# connection budget divided by the number of API instances, NOT from the
# CPU count — Prisma's default (num_cpus * 2 + 1, per process) will exhaust
# a serverless Postgres like Neon as soon as you run more than one instance.
DATABASE_POOL_SIZE=10
# Seconds a query waits for a free connection before failing.
DATABASE_POOL_TIMEOUT=10

# Optional: Redis for horizontally-scaled sockets (Phase 3.8) and for the
# shared weather/destinations read-through cache (Phase 10). Without it,
# sockets run single-instance and the cache is per-process.
REDIS_URL=

# Optional observability (Phase 11). Error reporting is a no-op unless
# SENTRY_DSN is set AND `@sentry/node` is installed.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
RELEASE_VERSION=

# Structured logger floor: debug | info | warn | error
LOG_LEVEL=

# Object storage for user-uploaded media (avatar upload, Phase 8.2). All
# five must be set together for uploads to work — leave unset and the
# server still boots, uploads just report "not available" instead of
# faking one. Works with AWS S3 or any S3-compatible provider (Cloudflare
# R2, MinIO, Backblaze B2); set OBJECT_STORAGE_ENDPOINT for a non-AWS one,
# leave it blank for real AWS S3.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_ENDPOINT=
# The base URL uploaded files are publicly readable from afterwards (the
# bucket's own public URL, or a CDN in front of it).
OBJECT_STORAGE_PUBLIC_URL_BASE=
