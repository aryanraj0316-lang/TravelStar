// A device's Expo push token (docs/REMEDIATION.md §8.18 — the
// `pushNotifications` profile toggle used to do nothing at all: no token
// was ever registered, so no push could ever be delivered). One row per
// device, keyed by the token itself so re-registering the same device is
// an upsert rather than a duplicate. Rows are deleted on logout and when
// the Expo push service reports DeviceNotRegistered.
model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String // 'ios' | 'android' | 'web'
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// Append-only consent log (docs/REMEDIATION.md §12.3 — "explicit, granular
// consent capture for location, camera, photos, and notifications, with
// timestamps and the policy version consented to"). A row is written every
// time a user grants or revokes one category — never updated in place —
// so the history itself is the audit trail a DPDP/GDPR-style request needs,
// not just a snapshot of the current state. "Current" is simply the latest
// row per (userId, category).
model ConsentRecord {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      ConsentCategory
  granted       Boolean
  policyVersion String
  createdAt     DateTime        @default(now())

  @@index([userId, category, createdAt])
}

// Per-user read state for broadcast notifications (userId: null on
// Notification — sent to every user at once). A personal notification's
// read state lives directly on its own `unread` column; a broadcast's does
// not, since it's shared, so "read" for a given user is recorded here
// instead of mutating the shared row (docs/REMEDIATION.md §5.8 — the old
// code flipped `unread` on the shared row, marking a broadcast read for
// every user the moment any one of them opened it).
model NotificationRead {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
  @@index([userId])
}

// A destination a user has bookmarked from the destination-detail screen.
//
// Before this the profile screen's "Saved Destinations" list read
// `profile.savedPlaces`, a field that existed only in the client's
// UserProfile type: the server's updateProfile schema has no such key, so
// Zod stripped it and answered `ok: true` while saving nothing. There was
// also no control anywhere in the app that could add to it, so the list was
// permanently empty and its delete button wrote to a value the server
// discarded. This is the real thing: a row per (user, destination).
model SavedDestination {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  // One bookmark per destination per user — saving twice is idempotent.
  @@unique([userId, destinationId])
  @@index([userId])
}

model Destination {
  id        String   @id @default(uuid())
  name      String
  tags      String
  rating    Float    @default(4.5)
  image     String
  rank      Int      @default(0)
  featured  Boolean  @default(false)
  // Detail-screen content (docs/REMEDIATION.md §8.19 — destination-details.tsx
  // previously rendered a hardcoded client-side DESTINATIONS_DATABASE
  // constant instead of the API). No reviews field: there is no real
  // review-authoring feature yet (§8.14, not built), and fabricating
  // reviewer identities to fill the space would be exactly the kind of
  // mock data §0.2 bans — the detail screen shows an honest empty state
  // instead.
  description String   @default("")
  gallery     String[] @default([])
  specialties Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedBy SavedDestination[]

  @@index([rank])
}

