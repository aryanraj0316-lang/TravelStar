datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

enum UserRole {
  TOURIST
  GUIDE
  ORGANIZER
  FAMILY_TRAVELER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  NONE
}

enum PrivacySetting {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
}

enum BookingType {
  TRIP
  GUIDE
  HOTEL
  VEHICLE
  LOCAL_EXPERIENCE
  TEMPLE_DARSHAN
  ADVENTURE_ACTIVITY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  REFUND
  CASHBACK
  REWARD
  REFERRAL
}

enum MediaType {
  NONE
  IMAGE
  VOICE
}

enum AlertSeverity {
  CRITICAL
  WARNING
  ADVISORY
}

// Values map to the exact strings already live in the database (with spaces
// and "&") so the migration converting the column doesn't orphan existing
// rows — see docs/REMEDIATION.md §4.5.
//
// CYCLONE, EARTHQUAKE, and WILDFIRE were added alongside broadening
// src/lib/hazard-feed.ts's live GDACS sync beyond flood/cyclone (which it
// had previously collapsed into FLOOD_RAIN) to also cover GDACS's EQ and WF
// event types — see that file's header comment.
enum AlertCategory {
  FLOOD_RAIN   @map("FLOOD & RAIN")
  LANDSLIDE
  CLOUDBURST
  TRAFFIC_RUSH @map("TRAFFIC RUSH")
  CYCLONE
  EARTHQUAKE
  WILDFIRE
}

// Deliberately a separate scale from AlertSeverity — MonsoonAdvisory and
// Alert are different models with different severity vocabularies that
// happened to both be called "severity".
enum MonsoonSeverity {
  HIGH
  MEDIUM
  LOW
}

enum NotificationType {
  TRIP
  HAZARD
  SEASONAL
}

enum NotificationCategory {
  JOIN_ACCEPTED
  CHAT_ADDED
}

enum MapPinType {
  GUIDE
  GROUP
  TOURIST
  ATTRACTION
}

enum SOSAlertStatus {
  ACTIVE
  RESOLVED
}

enum TripMemberRole {
  MEMBER
  ORGANIZER
  CO_LEAD
}

// Represents whether a trip is open, full, cancelled, or finished. Adding
// this makes trip cancellation representable in the data model — the actual
// cancel endpoint, refund handling, and UI are deferred (they depend on
// Phase 5's payments decision), so nothing writes CANCELLED yet.
enum TripStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

// How travellers move between two consecutive stops on a trip's timeline.
// Mirrors the four options the create-trip Timeline tab offers.
enum TransitMode {
  CAB
  TRAIN
  FLIGHT
  BUS
}

// The permission categories this app actually requests (docs/REMEDIATION.md
// §12.3). No KYC entry — identity verification was removed outright in
// §12.1, so there is nothing to consent to there.
enum ConsentCategory {
  LOCATION
  CAMERA
  PHOTOS
  NOTIFICATIONS
}

model User {
  id                 String             @id @default(uuid())
  email              String?            @unique
  phoneNumber        String?            @unique
  passwordHash       String?
  role               UserRole           @default(TOURIST)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  verificationStatus VerificationStatus @default(NONE)

  // Auth Relations
  socialLogins SocialLogin[]

  // Profile
  profile      Profile?
  guideProfile GuideProfile?

  // App Relations
  createdTrips    Trip[]        @relation("TripCreator")
  tripMemberships TripMember[]
  joinRequests    JoinRequest[]
  tripLikes       TripLike[]

  // Group Relations
  createdGroups    Group[]        @relation("GroupCreator")
  groupMemberships GroupMember[]
  groupPosts       GroupPost[]
  groupComments    GroupComment[]
  votes            PollVote[]
  expensesPaid     Expense[]      @relation("ExpensePaidBy")
  tripExpensesPaid TripExpense[]  @relation("TripExpensePaidBy")

  // Payments & Wallet
  wallet       Wallet?
  transactions Transaction[]
  bookings     Booking[]     @relation("UserBookings")

  // Safety
  sosAlerts         SOSAlert[]
  emergencyContacts EmergencyContact[]
  liveLocations     LiveLocation[]

  // Notifications
  notifications      Notification[]
  notificationReads  NotificationRead[]
  deviceTokens       DeviceToken[]

  // Privacy & consent
  consentRecords ConsentRecord[]

  // Destinations this user has bookmarked (profile > Saved Destinations)
  savedDestinations SavedDestination[]

  // Social Relations
  followers Follow[]  @relation("Following")
  following Follow[]  @relation("Follower")
  blogs     Blog[]
  likes     Like[]
  comments  Comment[]

  // Chat Relations
  chatMemberships ChatRoomMember[]
  sentMessages    Message[]            @relation("MessageSender")
  readReceipts    MessageReadReceipt[]
  initiatedCalls  CallLog[]            @relation("CallInitiator")
  receivedCalls   CallLog[]            @relation("CallReceiver")

  // Admin Logs
  adminActions AdminLog[]

  // Auth sessions
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model SocialLogin {
  id         String   @id @default(uuid())
  userId     String
  provider   String // 'google', 'facebook', 'apple'
  providerId String   @unique
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  avatarUrl        String?
  coverPhotoUrl    String?
  bio              String?
  age              Int?
  gender           String?
  languages        String[] // Array of languages spoken
  country          String   @default("India")
  state            String?
  city             String?
  interests        String[] // List of user interests
  budgetPreference String? // 'budget', 'moderate', 'luxury'
  travelStyle      String[] // 'adventure', 'luxury', 'religious', 'backpacking', 'family', 'solo'
  verifiedBadge    Boolean  @default(false)
  rating           Float    @default(5.0)

  // No KYC/Aadhaar document storage (docs/REMEDIATION.md §12.1). Storing
  // raw Aadhaar numbers or ID/face images is not permitted for a private
  // entity without a licensed KYC provider and field-level encryption;
  // v1 does not do identity verification at all. If it is added later it
  // must go through a KYC provider that returns only a pass/fail + a
  // reference — never the document or the number.

  // Master switch, then per-category opt-outs (docs/REMEDIATION.md §8.18).
  // The categories mirror NotificationType; a push is sent only when the
  // master switch and the matching category are both on. Defaulting the
  // categories to true keeps existing users' behaviour unchanged — the
  // master switch is the one they have actually seen and set.
  pushNotifications Boolean  @default(true)
  pushTripUpdates   Boolean  @default(true)
  pushHazardAlerts  Boolean  @default(true)
  pushSeasonal      Boolean  @default(true)
  locationSharing   Boolean  @default(true)
  selectedLanguage  String   @default("English")
  updatedAt         DateTime @updatedAt
}

model GuideProfile {
  id              String             @id @default(uuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber   String             @unique
  licensePhotoUrl String?            // optional — v1 stores no credential documents (§12.1)
  experienceYears Int
  expertisePlaces String[] // List of places/destinations
  languagesSpoken String[]
  hourlyRate      Decimal            @db.Decimal(12, 2)
  dailyRate       Decimal            @db.Decimal(12, 2)
  availability    Json // Weekly/custom calendar representation
  verifiedStatus  VerificationStatus @default(PENDING)
  // Null until a real review exists. It used to default to 5.0, so every
  // brand-new unverified guide was presented to travellers at full marks.
  rating          Float?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  packages GuidePackage[]
  quotes   GuideQuote[]
  bookings Booking[]      @relation("GuideBookings")
  reviews  Review[]
  reels    GuideReel[]
}

model GuidePackage {
  id             String       @id @default(uuid())
  guideProfileId String
  guide          GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  title          String
  description    String
  price          Decimal      @db.Decimal(12, 2)
  durationDays   Int
  citiesIncluded String[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([guideProfileId])
}

model GuideReel {
  id             String       @id @default(uuid())
  guideProfileId String
  guide          GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  videoUrl       String
  thumbnailUrl   String?
  caption        String?
  viewsCount     Int          @default(0)
  likesCount     Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([guideProfileId])
}

model Trip {
  id             String         @id @default(uuid())
  creatorId      String
  creator        User           @relation("TripCreator", fields: [creatorId], references: [id])
  name           String
  description    String
  cities         String[] // Multi-city route details (e.g. ['Ranchi', 'Delhi', 'Mathura'])
  startDate      DateTime
  endDate        DateTime
  durationDays   Int
  budget         Decimal        @db.Decimal(12, 2)
  availableSeats Int
  totalSeats     Int
  meetingPoint   String
  vehicleDetails String?
  hotelDetails   String?
  foodIncluded   Boolean        @default(false)
  guideIncluded  Boolean        @default(false)
  hotelIncluded  Boolean        @default(false)
  cabIncluded    Boolean        @default(false)
  privacy        PrivacySetting @default(PUBLIC)
  status         TripStatus     @default(ACTIVE)
  rules          String?
  requirements   String?
  ageLimitMin    Int?
  ageLimitMax    Int?
  genderPref     String? // 'Any', 'MaleOnly', 'FemaleOnly'
  coverImage     String?
  category       String?
  languages      String[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  chatRoom       ChatRoom?

  members   TripMember[]
  requests  JoinRequest[]
  bookings  Booking[]
  likes     TripLike[]
  expenses  TripExpense[]
  itinerary TripItineraryDay[]
  timeline  TripTimelineStop[]
  checklist TripChecklistItem[]
  quotes    GuideQuote[]

  @@index([creatorId])
  @@index([createdAt])
}

model TripMember {
  id       String         @id @default(uuid())
  tripId   String
  trip     Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime       @default(now())
  role     TripMemberRole @default(MEMBER)
  // Organizer roster tools (docs/REMEDIATION.md §8.6 — group-organizer.tsx).
  // These three used to be pure client-side useState, silently discarded
  // the next time the member list was refetched from the server.
  checkedInAt   DateTime?
  roomAllocated String?
  seatAllocated String?

  @@unique([tripId, userId])
  @@index([userId])
}

model JoinRequest {
  id            String            @id @default(uuid())
  tripId        String
  trip          Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        JoinRequestStatus @default(PENDING)
  message       String?
  fromCity      String? // For Family Connect: where the user joins from
  toCity        String? // For Family Connect: where the user travels to
  adjustedPrice Decimal?          @db.Decimal(12, 2) // Auto-calculated adjusted payment for remaining cities
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([status])
}

model Group {
  id          String         @id @default(uuid())
  creatorId   String
  creator     User           @relation("GroupCreator", fields: [creatorId], references: [id])
  name        String
  description String
  joiningFee  Decimal        @default(0.0) @db.Decimal(12, 2)
  isPaid      Boolean        @default(false)
  privacy     PrivacySetting @default(PUBLIC)
  avatarUrl   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  members       GroupMember[]
  posts         GroupPost[]
  announcements Announcement[]
  polls         Poll[]
  expenses      Expense[]
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())
  role     String   @default("MEMBER") // 'OWNER', 'ADMIN', 'MEMBER'

  attendance Attendance[]

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupPost {
  id        String         @id @default(uuid())
  groupId   String
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  imageUrl  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  comments  GroupComment[]

  @@index([groupId])
}

model GroupComment {
  id        String    @id @default(uuid())
  postId    String
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([postId])
}

model Announcement {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime @default(now())
}

model Poll {
  id        String       @id @default(uuid())
  groupId   String
  group     Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  question  String
  expiresAt DateTime
  createdAt DateTime     @default(now())
  options   PollOption[]
}

model PollOption {
  id     String     @id @default(uuid())
  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String
  votes  PollVote[]
}

model PollVote {
  id       String     @id @default(uuid())
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
}

model Expense {
  id          String   @id @default(uuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal  @db.Decimal(12, 2)
  paidById    String
  paidBy      User     @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: Cascade)
  splitData   Json // Details of how expenses are split between members
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([groupId])
}

// Shared trip expenses (docs/REMEDIATION.md §8.12). Separate from the
// Group-scoped Expense model above: budget-tracker.tsx is trip-scoped, and
// the two features don't overlap. Each expense is paid by one trip member
// and split equally across everyone on the trip (organizer + confirmed
// members) at read time — the split is derived, never stored, so it can't
// drift when membership changes.
model TripExpense {
  id          String   @id @default(uuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal  @db.Decimal(12, 2)
  category    String   @default("OTHER") // TRANSPORT | LODGING | FOOD | ACTIVITY | OTHER
  paidById    String
  paidBy      User     @relation("TripExpensePaidBy", fields: [paidById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tripId])
  @@index([paidById])
}

// Day-by-day plan for a trip, authored by its organiser
// (docs/REMEDIATION.md §8.6 — group-organizer.tsx's "Day Schedule" tab).
// That tab used to render two hardcoded days for every trip, and its
// "Insert Itinerary Day" button only pushed onto local useState, so the
// day vanished on unmount and no member ever saw it.
model TripItineraryDay {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day       Int
  title     String
  plan      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, day])
  @@index([tripId])
}

// One stop on a trip's route, as built on the create-trip Timeline tab.
//
// Deliberately separate from TripItineraryDay: that model is day-indexed
// (Day 1, Day 2, … with a free-text plan) and is what the organizer
// dashboard edits after a trip exists. This one is *stop*-indexed — a city
// the group stays in for `stayDays` days, and how they travel to the next
// one. The two have different granularity (one stop can span several days),
// so folding them together would misrepresent both.
//
// `transitTimeMinutes` and `transitMode` describe the leg travelled to
// REACH this stop, so they are null on the first stop — there is no inbound
// leg to the starting point. Latitude/longitude are nullable because a city
// the geocoder cannot place must be stored without coordinates rather than
// with invented ones (docs/REMEDIATION.md §0.2 rule 4); the map reports how
// many stops it could not plot instead of drawing them somewhere wrong.
model TripTimelineStop {
  id                 String       @id @default(uuid())
  tripId             String
  trip               Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  // 0-based position along the route.
  order              Int
  city               String
  // Nights the group spends at this stop.
  stayDays           Int          @default(1)
  // Travel time to reach this stop, in minutes. Null on the first stop.
  transitTimeMinutes Int?
  // How the group travels to reach this stop. Null on the first stop.
  transitMode        TransitMode?
  // What the group does here. Empty when the organizer left it blank.
  activities         String       @default("")
  latitude           Float?
  longitude          Float?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([tripId, order])
  @@index([tripId])
}

// A packing/prep item the organizer put on the trip's checklist, so someone
// deciding whether to join can see what they are expected to bring. Before
// this the create screen's Checklist tab was eight hardcoded strings in
// local component state that were discarded when the screen unmounted and
// never reached any traveller.
model TripChecklistItem {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  order     Int
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, order])
  @@index([tripId])
}

model Attendance {
  id        String      @id @default(uuid())
  memberId  String
  member    GroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date      DateTime    @db.Date
  isPresent Boolean     @default(true)
  remarks   String?

  @@unique([memberId, date])
}

model Booking {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation("UserBookings", fields: [userId], references: [id])
  type           BookingType
  // Fallback identifier for booking types with no modeled entity yet (HOTEL,
  // VEHICLE, LOCAL_EXPERIENCE, TEMPLE_DARSHAN, ADVENTURE_ACTIVITY — none of
  // those have a table in this schema, so there is nothing to point a real
  // FK at without inventing product surface that doesn't exist elsewhere in
  // the app). TRIP and GUIDE bookings must use tripId/guideProfileId below,
  // not this field — those are the two types that do have a real relation.
  targetId       String?
  guideProfileId String?
  guide          GuideProfile? @relation("GuideBookings", fields: [guideProfileId], references: [id])
  tripId         String?
  trip           Trip?         @relation(fields: [tripId], references: [id])
  bookingDate    DateTime      @default(now())
  travelDate     DateTime
  amount         Decimal       @db.Decimal(12, 2)
  status         BookingStatus @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  ticketData     Json? // QR codes, offline validation info
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payments Payment[]

  @@index([userId])
  @@index([guideProfileId])
  @@index([bookingDate])
}

model Payment {
  id           String        @id @default(uuid())
  bookingId    String
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  gateway      String // 'RAZORPAY', 'STRIPE', 'WALLET' — left as a string; unused today (see docs/REMEDIATION.md §5.5, no code creates a Payment row yet) and pending the Phase 5 payments decision
  gatewayTxnId String        @unique
  amount       Decimal       @db.Decimal(12, 2)
  status       PaymentStatus @default(PENDING)
  couponCode   String?
  gstInvoiceId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([bookingId])
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Decimal             @default(0.0) @db.Decimal(12, 2)
  rewardPoints Int                 @default(0)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id        String          @id @default(uuid())
  walletId  String
  wallet    Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount    Decimal         @db.Decimal(12, 2)
  type      TransactionType
  remark    String?
  createdAt DateTime        @default(now())

  @@index([walletId])
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  status      PaymentStatus   @default(SUCCESS)
  description String?
  createdAt   DateTime        @default(now())

  @@index([userId])
}

model ChatRoom {
  id        String           @id @default(uuid())
  name      String? // Dynamic name or specific name for groups
  isGroup   Boolean          @default(false)
  createdAt DateTime         @default(now())
  members   ChatRoomMember[]
  messages  Message[]
  tripId    String?          @unique
  trip      Trip?            @relation(fields: [tripId], references: [id])
}

model ChatRoomMember {
  id         String   @id @default(uuid())
  chatRoomId String
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())

  @@unique([chatRoomId, userId])
  @@index([userId])
}

model Message {
  id         String               @id @default(uuid())
  chatRoomId String
  chatRoom   ChatRoom             @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User                 @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content    String?
  mediaType  MediaType?
  mediaUrl   String?
  isSystem   Boolean              @default(false)
  createdAt  DateTime             @default(now())
  readBy     MessageReadReceipt[]

  @@index([chatRoomId, createdAt])
  @@index([senderId])
}

model MessageReadReceipt {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
}

model CallLog {
  id          String    @id @default(uuid())
  initiatorId String
  initiator   User      @relation("CallInitiator", fields: [initiatorId], references: [id])
  receiverId  String
  receiver    User      @relation("CallReceiver", fields: [receiverId], references: [id])
  isVideo     Boolean   @default(false)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  durationSec Int?
}

model SOSAlert {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  alertTime DateTime       @default(now())
  status    SOSAlertStatus @default(ACTIVE)

  @@index([userId])
  @@index([status])
}

model EmergencyContact {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  relation    String
  phoneNumber String

  @@index([userId])
}

model LiveLocation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  updatedAt DateTime @default(now())

  @@index([userId])
  // Both the live map's freshness filter (routes/map.ts, "gte: freshAfter")
  // and the retention purge job (lib/data-retention.ts, "lt: cutoff") filter
  // and order on this column — it was missing from Phase 4's original
  // indexing sweep.
  @@index([updatedAt])
}

model Review {
  id             String       @id @default(uuid())
  guideProfileId String
  guide          GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  reviewerName   String
  rating         Float
  comment        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([guideProfileId])
}

model Blog {
  id        String    @id @default(uuid())
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  content   String
  coverImg  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  likes     Like[]
  comments  Comment[]
}

model Like {
  id        String   @id @default(uuid())
  blogId    String
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blogId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  blogId    String
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([blogId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model AdminLog {
  id        String   @id @default(uuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  action    String
  ipAddress String?
  createdAt DateTime @default(now())
}

model MapPin {
  id        String     @id @default(uuid())
  type      MapPinType
  name      String
  latitude  Float
  longitude Float
  detail    String
  // Points at a User (GUIDE/TOURIST) or Group (GROUP) row depending on
  // `type`; ATTRACTION has no modeled entity. Not a real FK for the same
  // reason as Booking.targetId above — no backend route touches this model
  // yet (docs/REMEDIATION.md §8.8, Map, is where it gets wired up), and
  // guessing which relation to attach without a real caller risks getting it
  // wrong silently.
  targetId  String?
  createdAt DateTime   @default(now())
}

model Notification {
  id         String                @id @default(uuid())
  userId     String?
  user       User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  content    String
  time       String
  unread     Boolean               @default(true)
  chatRoomId String?
  tripId     String?
  category   NotificationCategory?
  createdAt  DateTime              @default(now())
  reads      NotificationRead[]

  @@index([userId])
  @@index([unread])
}

// A device's Expo push token (docs/REMEDIATION.md §8.18 — the
// `pushNotifications` profile toggle used to do nothing at all: no token
// was ever registered, so no push could ever be delivered). One row per
// device, keyed by the token itself so re-registering the same device is
// an upsert rather than a duplicate. Rows are deleted on logout and when
// the Expo push service reports DeviceNotRegistered.
model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String // 'ios' | 'android' | 'web'
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// Append-only consent log (docs/REMEDIATION.md §12.3 — "explicit, granular
// consent capture for location, camera, photos, and notifications, with
// timestamps and the policy version consented to"). A row is written every
// time a user grants or revokes one category — never updated in place —
// so the history itself is the audit trail a DPDP/GDPR-style request needs,
// not just a snapshot of the current state. "Current" is simply the latest
// row per (userId, category).
model ConsentRecord {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      ConsentCategory
  granted       Boolean
  policyVersion String
  createdAt     DateTime        @default(now())

  @@index([userId, category, createdAt])
}

// Per-user read state for broadcast notifications (userId: null on
// Notification — sent to every user at once). A personal notification's
// read state lives directly on its own `unread` column; a broadcast's does
// not, since it's shared, so "read" for a given user is recorded here
// instead of mutating the shared row (docs/REMEDIATION.md §5.8 — the old
// code flipped `unread` on the shared row, marking a broadcast read for
// every user the moment any one of them opened it).
model NotificationRead {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
  @@index([userId])
}

// A destination a user has bookmarked from the destination-detail screen.
//
// Before this the profile screen's "Saved Destinations" list read
// `profile.savedPlaces`, a field that existed only in the client's
// UserProfile type: the server's updateProfile schema has no such key, so
// Zod stripped it and answered `ok: true` while saving nothing. There was
// also no control anywhere in the app that could add to it, so the list was
// permanently empty and its delete button wrote to a value the server
// discarded. This is the real thing: a row per (user, destination).
model SavedDestination {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  // One bookmark per destination per user — saving twice is idempotent.
  @@unique([userId, destinationId])
  @@index([userId])
}

model Destination {
  id        String   @id @default(uuid())
  name      String
  tags      String
  rating    Float    @default(4.5)
  image     String
  rank      Int      @default(0)
  featured  Boolean  @default(false)
  // Detail-screen content (docs/REMEDIATION.md §8.19 — destination-details.tsx
  // previously rendered a hardcoded client-side DESTINATIONS_DATABASE
  // constant instead of the API). No reviews field: there is no real
  // review-authoring feature yet (§8.14, not built), and fabricating
  // reviewer identities to fill the space would be exactly the kind of
  // mock data §0.2 bans — the detail screen shows an honest empty state
  // instead.
  description String   @default("")
  gallery     String[] @default([])
  specialties Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedBy SavedDestination[]

  @@index([rank])
}

model WeatherLocation {
  id            String   @id @default(uuid())
  name          String
  place         String
  temp          String
  condition     String
  aqi           String
  humidity      String
  image         String
  lastFetchedAt DateTime @default(now())
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())
}

model MonsoonAdvisory {
  id          String          @id @default(uuid())
  region      String
  severity    MonsoonSeverity
  alertTitle  String
  description String
  updatedAt   DateTime        @updatedAt
  createdAt   DateTime        @default(now())
}

model Alert {
  id            String        @id @default(uuid())
  severity      AlertSeverity
  title         String
  category      AlertCategory
  location      String
  time          String
  desc          String
  affectedRoute String
  precautions   String[]
  image         String
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([active])
}

model TravelStory {
  id           String   @id @default(uuid())
  authorName   String
  authorAvatar String?
  title        String
  content      String
  coverImg     String?
  likesCount   Int      @default(0)
  location     String
  hasReel      Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model TripLike {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tripId, userId])
  @@index([tripId])
}

model GuideQuote {
  id             String       @id @default(uuid())
  guideProfileId String
  guide          GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  tripId         String
  trip           Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  amount         Decimal      @db.Decimal(12, 2)
  message        String?
  status         QuoteStatus  @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // One live quote per guide per trip - re-quoting updates the existing row
  // rather than letting a guide flood an organizer's inbox.
  @@unique([guideProfileId, tripId])
  @@index([tripId])
  @@index([guideProfileId])
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  DECLINED
}
