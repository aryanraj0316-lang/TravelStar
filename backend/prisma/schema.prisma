datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  TOURIST
  GUIDE
  ORGANIZER
  FAMILY_TRAVELER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  NONE
}

enum PrivacySetting {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
}

enum BookingType {
  TRIP
  GUIDE
  HOTEL
  VEHICLE
  LOCAL_EXPERIENCE
  TEMPLE_DARSHAN
  ADVENTURE_ACTIVITY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  REFUND
  CASHBACK
  REWARD
  REFERRAL
}

enum MediaType {
  NONE
  IMAGE
  VOICE
}

enum AlertSeverity {
  CRITICAL
  WARNING
  ADVISORY
}

// Values map to the exact strings already live in the database (with spaces
// and "&") so the migration converting the column doesn't orphan existing
// rows — see docs/REMEDIATION.md §4.5.
enum AlertCategory {
  FLOOD_RAIN   @map("FLOOD & RAIN")
  LANDSLIDE
  CLOUDBURST
  TRAFFIC_RUSH @map("TRAFFIC RUSH")
}

// Deliberately a separate scale from AlertSeverity — MonsoonAdvisory and
// Alert are different models with different severity vocabularies that
// happened to both be called "severity".
enum MonsoonSeverity {
  HIGH
  MEDIUM
  LOW
}

enum NotificationType {
  TRIP
  HAZARD
  SEASONAL
}

enum NotificationCategory {
  JOIN_ACCEPTED
  CHAT_ADDED
}

enum MapPinType {
  GUIDE
  GROUP
  TOURIST
  ATTRACTION
}

enum SOSAlertStatus {
  ACTIVE
  RESOLVED
}

enum TripMemberRole {
  MEMBER
  ORGANIZER
  CO_LEAD
}

// Represents whether a trip is open, full, cancelled, or finished. Adding
// this makes trip cancellation representable in the data model — the actual
// cancel endpoint, refund handling, and UI are deferred (they depend on
// Phase 5's payments decision), so nothing writes CANCELLED yet.
enum TripStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

model User {
  id                 String             @id @default(uuid())
  email              String?            @unique
  phoneNumber        String?            @unique
  passwordHash       String?
  role               UserRole           @default(TOURIST)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  verificationStatus VerificationStatus @default(NONE)

  // Auth Relations
  socialLogins SocialLogin[]

  // Profile
  profile      Profile?
  guideProfile GuideProfile?

  // App Relations
  createdTrips    Trip[]        @relation("TripCreator")
  tripMemberships TripMember[]
  joinRequests    JoinRequest[]
  tripLikes       TripLike[]

  // Group Relations
  createdGroups    Group[]        @relation("GroupCreator")
  groupMemberships GroupMember[]
  groupPosts       GroupPost[]
  groupComments    GroupComment[]
  votes            PollVote[]
  expensesPaid     Expense[]      @relation("ExpensePaidBy")

  // Payments & Wallet
  wallet       Wallet?
  transactions Transaction[]
  bookings     Booking[]     @relation("UserBookings")

  // Safety
  sosAlerts         SOSAlert[]
  emergencyContacts EmergencyContact[]
  liveLocations     LiveLocation[]

  // Notifications
  notifications      Notification[]
  notificationReads  NotificationRead[]

  // Social Relations
  followers Follow[]  @relation("Following")
  following Follow[]  @relation("Follower")
  blogs     Blog[]
  likes     Like[]
  comments  Comment[]

  // Chat Relations
  chatMemberships ChatRoomMember[]
  sentMessages    Message[]            @relation("MessageSender")
  readReceipts    MessageReadReceipt[]
  initiatedCalls  CallLog[]            @relation("CallInitiator")
  receivedCalls   CallLog[]            @relation("CallReceiver")

  // Admin Logs
  adminActions AdminLog[]

  // Auth sessions
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model SocialLogin {
  id         String   @id @default(uuid())
  userId     String
  provider   String // 'google', 'facebook', 'apple'
  providerId String   @unique
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  avatarUrl        String?
  coverPhotoUrl    String?
  bio              String?
  age              Int?
  gender           String?
  languages        String[] // Array of languages spoken
  country          String   @default("India")
  state            String?
  city             String?
  interests        String[] // List of user interests
  budgetPreference String? // 'budget', 'moderate', 'luxury'
  travelStyle      String[] // 'adventure', 'luxury', 'religious', 'backpacking', 'family', 'solo'
  verifiedBadge    Boolean  @default(false)
  rating           Float    @default(5.0)

  // Documents for verification
  aadhaarNumber       String?
  aadhaarPhotoUrl     String?
  govIdType           String? // 'Passport', 'PAN', 'VoterID'
  govIdPhotoUrl       String?
  faceVerificationImg String?
  selfieVerification  String?

  pushNotifications Boolean  @default(true)
  locationSharing   Boolean  @default(true)
  selectedLanguage  String   @default("English")
  updatedAt         DateTime @updatedAt
}

model GuideProfile {
  id              String             @id @default(uuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber   String             @unique
  licensePhotoUrl String
  experienceYears Int
  expertisePlaces String[] // List of places/destinations
  languagesSpoken String[]
  hourlyRate      Decimal            @db.Decimal(12, 2)
  dailyRate       Decimal            @db.Decimal(12, 2)
  availability    Json // Weekly/custom calendar representation
  verifiedStatus  VerificationStatus @default(PENDING)
  rating          Float              @default(5.0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  packages GuidePackage[]
  bookings Booking[]      @relation("GuideBookings")
  reviews  Review[]
  reels    GuideReel[]
}

model GuidePackage {
  id             String       @id @default(uuid())
  guideProfileId String
  guide          GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  title          String
  description    String
  price          Decimal      @db.Decimal(12, 2)
  durationDays   Int
  citiesIncluded String[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([guideProfileId])
}

model GuideReel {
  id             String       @id @default(uuid())
  guideProfileId String
  guide          GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  videoUrl       String
  thumbnailUrl   String?
  caption        String?
  viewsCount     Int          @default(0)
  likesCount     Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([guideProfileId])
}

model Trip {
  id             String         @id @default(uuid())
  creatorId      String
  creator        User           @relation("TripCreator", fields: [creatorId], references: [id])
  name           String
  description    String
  cities         String[] // Multi-city route details (e.g. ['Ranchi', 'Delhi', 'Mathura'])
  startDate      DateTime
  endDate        DateTime
  durationDays   Int
  budget         Decimal        @db.Decimal(12, 2)
  availableSeats Int
  totalSeats     Int
  meetingPoint   String
  vehicleDetails String?
  hotelDetails   String?
  foodIncluded   Boolean        @default(false)
  guideIncluded  Boolean        @default(false)
  hotelIncluded  Boolean        @default(false)
  cabIncluded    Boolean        @default(false)
  privacy        PrivacySetting @default(PUBLIC)
  status         TripStatus     @default(ACTIVE)
  rules          String?
  requirements   String?
  ageLimitMin    Int?
  ageLimitMax    Int?
  genderPref     String? // 'Any', 'MaleOnly', 'FemaleOnly'
  coverImage     String?
  category       String?
  languages      String[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  chatRoom       ChatRoom?

  members  TripMember[]
  requests JoinRequest[]
  bookings Booking[]
  likes    TripLike[]

  @@index([creatorId])
  @@index([createdAt])
}

model TripMember {
  id       String         @id @default(uuid())
  tripId   String
  trip     Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime       @default(now())
  role     TripMemberRole @default(MEMBER)

  @@unique([tripId, userId])
  @@index([userId])
}

model JoinRequest {
  id            String            @id @default(uuid())
  tripId        String
  trip          Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        JoinRequestStatus @default(PENDING)
  message       String?
  fromCity      String? // For Family Connect: where the user joins from
  toCity        String? // For Family Connect: where the user travels to
  adjustedPrice Decimal?          @db.Decimal(12, 2) // Auto-calculated adjusted payment for remaining cities
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([status])
}

model Group {
  id          String         @id @default(uuid())
  creatorId   String
  creator     User           @relation("GroupCreator", fields: [creatorId], references: [id])
  name        String
  description String
  joiningFee  Decimal        @default(0.0) @db.Decimal(12, 2)
  isPaid      Boolean        @default(false)
  privacy     PrivacySetting @default(PUBLIC)
  avatarUrl   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  members       GroupMember[]
  posts         GroupPost[]
  announcements Announcement[]
  polls         Poll[]
  expenses      Expense[]
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())
  role     String   @default("MEMBER") // 'OWNER', 'ADMIN', 'MEMBER'

  attendance Attendance[]

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupPost {
  id        String         @id @default(uuid())
  groupId   String
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  imageUrl  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  comments  GroupComment[]

  @@index([groupId])
}

model GroupComment {
  id        String    @id @default(uuid())
  postId    String
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([postId])
}

model Announcement {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime @default(now())
}

model Poll {
  id        String       @id @default(uuid())
  groupId   String
  group     Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  question  String
  expiresAt DateTime
  createdAt DateTime     @default(now())
  options   PollOption[]
}

model PollOption {
  id     String     @id @default(uuid())
  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String
  votes  PollVote[]
}

model PollVote {
  id       String     @id @default(uuid())
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
}

model Expense {
  id          String   @id @default(uuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal  @db.Decimal(12, 2)
  paidById    String
  paidBy      User     @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: Cascade)
  splitData   Json // Details of how expenses are split between members
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([groupId])
}

model Attendance {
  id        String      @id @default(uuid())
  memberId  String
  member    GroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  date      DateTime    @db.Date
  isPresent Boolean     @default(true)
  remarks   String?

  @@unique([memberId, date])
}

model Booking {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation("UserBookings", fields: [userId], references: [id])
  type           BookingType
  // Fallback identifier for booking types with no modeled entity yet (HOTEL,
  // VEHICLE, LOCAL_EXPERIENCE, TEMPLE_DARSHAN, ADVENTURE_ACTIVITY — none of
  // those have a table in this schema, so there is nothing to point a real
  // FK at without inventing product surface that doesn't exist elsewhere in
  // the app). TRIP and GUIDE bookings must use tripId/guideProfileId below,
  // not this field — those are the two types that do have a real relation.
  targetId       String?
  guideProfileId String?
  guide          GuideProfile? @relation("GuideBookings", fields: [guideProfileId], references: [id])
  tripId         String?
  trip           Trip?         @relation(fields: [tripId], references: [id])
  bookingDate    DateTime      @default(now())
  travelDate     DateTime
  amount         Decimal       @db.Decimal(12, 2)
  status         BookingStatus @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  ticketData     Json? // QR codes, offline validation info
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payments Payment[]

  @@index([userId])
  @@index([guideProfileId])
  @@index([bookingDate])
}

model Payment {
  id           String        @id @default(uuid())
  bookingId    String
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  gateway      String // 'RAZORPAY', 'STRIPE', 'WALLET' — left as a string; unused today (see docs/REMEDIATION.md §5.5, no code creates a Payment row yet) and pending the Phase 5 payments decision
  gatewayTxnId String        @unique
  amount       Decimal       @db.Decimal(12, 2)
  status       PaymentStatus @default(PENDING)
  couponCode   String?
  gstInvoiceId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([bookingId])
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Decimal             @default(0.0) @db.Decimal(12, 2)
  rewardPoints Int                 @default(0)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id        String          @id @default(uuid())
  walletId  String
  wallet    Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount    Decimal         @db.Decimal(12, 2)
  type      TransactionType
  remark    String?
  createdAt DateTime        @default(now())

  @@index([walletId])
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  status      PaymentStatus   @default(SUCCESS)
  description String?
  createdAt   DateTime        @default(now())

  @@index([userId])
}

model ChatRoom {
  id        String           @id @default(uuid())
  name      String? // Dynamic name or specific name for groups
  isGroup   Boolean          @default(false)
  createdAt DateTime         @default(now())
  members   ChatRoomMember[]
  messages  Message[]
  tripId    String?          @unique
  trip      Trip?            @relation(fields: [tripId], references: [id])
}

model ChatRoomMember {
  id         String   @id @default(uuid())
  chatRoomId String
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())

  @@unique([chatRoomId, userId])
  @@index([userId])
}

model Message {
  id         String               @id @default(uuid())
  chatRoomId String
  chatRoom   ChatRoom             @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User                 @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content    String?
  mediaType  MediaType?
  mediaUrl   String?
  isSystem   Boolean              @default(false)
  createdAt  DateTime             @default(now())
  readBy     MessageReadReceipt[]

  @@index([chatRoomId, createdAt])
  @@index([senderId])
}

model MessageReadReceipt {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
}

model CallLog {
  id          String    @id @default(uuid())
  initiatorId String
  initiator   User      @relation("CallInitiator", fields: [initiatorId], references: [id])
  receiverId  String
  receiver    User      @relation("CallReceiver", fields: [receiverId], references: [id])
  isVideo     Boolean   @default(false)
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  durationSec Int?
}

model SOSAlert {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  alertTime DateTime       @default(now())
  status    SOSAlertStatus @default(ACTIVE)

  @@index([userId])
  @@index([status])
}

model EmergencyContact {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  relation    String
  phoneNumber String

  @@index([userId])
}

model LiveLocation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  updatedAt DateTime @default(now())

  @@index([userId])
}

model Review {
  id             String       @id @default(uuid())
  guideProfileId String
  guide          GuideProfile @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  reviewerName   String
  rating         Float
  comment        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([guideProfileId])
}

model Blog {
  id        String    @id @default(uuid())
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  content   String
  coverImg  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  likes     Like[]
  comments  Comment[]
}

model Like {
  id        String   @id @default(uuid())
  blogId    String
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blogId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  blogId    String
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([blogId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model AppBanner {
  id        String   @id @default(uuid())
  imageUrl  String
  linkUrl   String?
  title     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Coupon {
  id        String   @id @default(uuid())
  code      String   @unique
  discount  Float // Percent or Flat amount
  isPercent Boolean  @default(true)
  expiresAt DateTime
  active    Boolean  @default(true)
}

model AdminLog {
  id        String   @id @default(uuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  action    String
  ipAddress String?
  createdAt DateTime @default(now())
}

model MapPin {
  id        String     @id @default(uuid())
  type      MapPinType
  name      String
  latitude  Float
  longitude Float
  detail    String
  // Points at a User (GUIDE/TOURIST) or Group (GROUP) row depending on
  // `type`; ATTRACTION has no modeled entity. Not a real FK for the same
  // reason as Booking.targetId above — no backend route touches this model
  // yet (docs/REMEDIATION.md §8.8, Map, is where it gets wired up), and
  // guessing which relation to attach without a real caller risks getting it
  // wrong silently.
  targetId  String?
  createdAt DateTime   @default(now())
}

model Notification {
  id         String                @id @default(uuid())
  userId     String?
  user       User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  content    String
  time       String
  unread     Boolean               @default(true)
  chatRoomId String?
  tripId     String?
  category   NotificationCategory?
  createdAt  DateTime              @default(now())
  reads      NotificationRead[]

  @@index([userId])
  @@index([unread])
}

// Per-user read state for broadcast notifications (userId: null on
// Notification — sent to every user at once). A personal notification's
// read state lives directly on its own `unread` column; a broadcast's does
// not, since it's shared, so "read" for a given user is recorded here
// instead of mutating the shared row (docs/REMEDIATION.md §5.8 — the old
// code flipped `unread` on the shared row, marking a broadcast read for
// every user the moment any one of them opened it).
model NotificationRead {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
  @@index([userId])
}

model Destination {
  id        String   @id @default(uuid())
  name      String
  tags      String
  rating    Float    @default(4.5)
  image     String
  rank      Int      @default(0)
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rank])
}

model WeatherLocation {
  id            String   @id @default(uuid())
  name          String
  place         String
  temp          String
  condition     String
  aqi           String
  humidity      String
  image         String
  lastFetchedAt DateTime @default(now())
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())
}

model MonsoonAdvisory {
  id          String          @id @default(uuid())
  region      String
  severity    MonsoonSeverity
  alertTitle  String
  description String
  updatedAt   DateTime        @updatedAt
  createdAt   DateTime        @default(now())
}

model Alert {
  id            String        @id @default(uuid())
  severity      AlertSeverity
  title         String
  category      AlertCategory
  location      String
  time          String
  desc          String
  affectedRoute String
  precautions   String[]
  image         String
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([active])
}

model TravelStory {
  id           String   @id @default(uuid())
  authorName   String
  authorAvatar String
  title        String
  content      String
  coverImg     String
  likesCount   Int      @default(0)
  location     String
  hasReel      Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model TripLike {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tripId, userId])
  @@index([tripId])
}
