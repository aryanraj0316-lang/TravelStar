// ── Payment-Gated Trip Join ────────────────────────────────────────────────
//
// One order per join-request, created when an organiser approves a request
// on a paid trip (docs/REMEDIATION.md §5.5 option A). The Razorpay order
// gates the seat claim: claimSeatAndJoin runs only after the HMAC-verified
// webhook (or the /verify endpoint) confirms captured payment. The seat is
// therefore always claimed after real money has moved — not on approval.
//
// idempotencyKey prevents duplicate orders when the client retries the
// /trip-payments/initiate call (CONVENTIONS.md §5).
//
// walletDebit + gatewayDebit allow split-payment: the traveller can pay
// part from their wallet and the rest via Razorpay.

enum TripPaymentOrderStatus {
  CREATED    // Razorpay order created; waiting for the traveller to pay
  PENDING    // Traveller has opened the checkout; payment in flight
  CAPTURED   // Payment verified and seat claimed
  FAILED     // Payment failed or expired
  REFUNDED   // Payment was refunded to wallet (post-rejection or cancellation)
}

model TripPaymentOrder {
  id                String                 @id @default(uuid())
  joinRequestId     String                 @unique
  joinRequest       JoinRequest            @relation(fields: [joinRequestId], references: [id], onDelete: Cascade)
  userId            String
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount            Decimal                @db.Decimal(12, 2)
  gateway           String                 // 'RAZORPAY' | 'WALLET' | 'SPLIT'
  razorpayOrderId   String?                @unique
  razorpayPaymentId String?
  status            TripPaymentOrderStatus @default(CREATED)
  // Client-generated UUIDv4 idempotency key (CONVENTIONS.md §5).
  // The initiate endpoint returns the existing row unchanged on a retry.
  idempotencyKey    String                 @unique
  walletDebit       Decimal?               @db.Decimal(12, 2)
  gatewayDebit      Decimal?               @db.Decimal(12, 2)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([userId])
  @@index([status])
}



