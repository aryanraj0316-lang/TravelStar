{
  "name": "travelstar-backend",
  "version": "1.0.0",
  "description": "Backend API for TravelStar",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "seed:reference": "ts-node prisma/seed-reference-data.ts",
    "test": "jest"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^6.9.0",
    "helmet": "^7.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.1",
    "socket.io": "^4.7.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.4.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "jest": "^29.6.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "prisma": "^5.0.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
